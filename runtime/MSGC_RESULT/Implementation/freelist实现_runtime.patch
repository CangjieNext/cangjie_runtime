+// ============================================================================
+// Opt-B: AllocFromMagazine / FlushMagazine
+// ============================================================================
+
+// Serve one slot from the per-class magazine; refill from region's freelist when empty.
+uintptr_t AllocBufferMS::AllocFromMagazine(uint8_t cls, MSRegionInfo* region)
+{
+    if (LIKELY(magHead_[cls] < magSize_[cls])) {
+        return magazine_[cls][magHead_[cls]++];
+    }
+    // Magazine empty: batch-drain up to kMagazineSize slots from the freelist.
+    // All these accesses happen in a tight loop; prefetch inside AllocFromFreelistFast
+    // hides the per-node cache-miss latency for the subsequent iteration (Opt-C).
+    magHead_[cls] = 0;
+    uint8_t n = 0;
+    while (n < kMagazineSize) {
+        uintptr_t slot = region->AllocFromFreelistFast();
+        if (slot == 0) break;
+        magazine_[cls][n++] = slot;
+    }
+    magSize_[cls] = n;
+    if (n == 0) return 0;
+    return magazine_[cls][magHead_[cls]++];
+}
+
+// Push remaining magazine items back into the active region's freelist (prepend).
+// Called by ReturnRegion before handing the region back to CentralRegionPool so
+// that freeSlotCount and freeHead remain consistent for pool classification.
+void AllocBufferMS::FlushMagazine(uint8_t cls)
+{
+    MSRegionInfo* region = activeRegions_[cls];
+    uint8_t head = magHead_[cls];
+    uint8_t size = magSize_[cls];
+    if (head >= size) {
+        // Nothing to flush
+        magHead_[cls] = magSize_[cls] = 0;
+        return;
+    }
+    if (LIKELY(region != nullptr)) {
+        while (head < size) {
+            uintptr_t slot = magazine_[cls][head++];
+            *reinterpret_cast<uintptr_t*>(slot) = region->freeHead;
+            region->freeHead = slot;
+            region->freeSlotCount++;
+        }
+    }
+    magHead_[cls] = 0;
+    magSize_[cls] = 0;
+}
