+// ============================================================================
+// TakeRegion/Reclaim stats — atomic snap + reset, and DumpStats for report.
+// ============================================================================
+
+FreeManager::TakeRegionStats FreeManager::SnapTakeRegionStats()
+{
+    TakeRegionStats s;
+    s.totalCalls      = takeRegionCalls_.exchange(0, std::memory_order_relaxed);
+    s.successCount    = takeRegionSuccess_.exchange(0, std::memory_order_relaxed);
+    s.emptyCount      = takeRegionEmpty_.exchange(0, std::memory_order_relaxed);
+    s.batchSizeSum    = takeRegionBatchSizeSum_.exchange(0, std::memory_order_relaxed);
+    s.durationNs      = takeRegionDurationNs_.exchange(0, std::memory_order_relaxed);
+    s.lockHoldNs      = takeRegionLockHoldNs_.exchange(0, std::memory_order_relaxed);
+    s.reclaimCalls    = reclaimCalls_.exchange(0, std::memory_order_relaxed);
+    s.reclaimBatchSizeSum = reclaimBatchSizeSum_.exchange(0, std::memory_order_relaxed);
+    s.reclaimDurationNs   = reclaimDurationNs_.exchange(0, std::memory_order_relaxed);
+    return s;
+}
+
+void FreeManager::DumpStats() const
+{
+    // Snapshot & reset via non-const self (we own the mutable atomics).
+    // We cast away const to call SnapTakeRegionStats since logging is logically non-const.
+    TakeRegionStats s = const_cast<FreeManager*>(this)->SnapTakeRegionStats();
+
+    if (s.totalCalls == 0 && s.reclaimCalls == 0) {
+        return;
+    }
+
+    uint64_t takeAvgNs = (s.totalCalls > 0) ? (s.durationNs / s.totalCalls) : 0;
+    uint64_t lockAvgNs = (s.totalCalls > 0) ? (s.lockHoldNs / s.totalCalls) : 0;
+    double avgBatch    = (s.totalCalls > 0) ? (static_cast<double>(s.batchSizeSum) / s.totalCalls) : 0.0;
+    uint64_t reclaimAvgNs = (s.reclaimCalls > 0) ? (s.reclaimDurationNs / s.reclaimCalls) : 0;
+    double avgReclaimBatch = (s.reclaimCalls > 0) ? (static_cast<double>(s.reclaimBatchSizeSum) / s.reclaimCalls) : 0.0;
+
+    VLOG(REPORT,
+         "[MS-GC] FreeManager.TakeRegion: calls=%lu success=%lu empty=%lu "
+         "avgBatch=%.1f totalDur=%luus avgDur=%luus lockHold=%luus avgLock=%luus",
+         (unsigned long)s.totalCalls,
+         (unsigned long)s.successCount,
+         (unsigned long)s.emptyCount,
+         avgBatch,
+         (unsigned long)(s.durationNs / 1000),
+         (unsigned long)(takeAvgNs / 1000),
+         (unsigned long)(s.lockHoldNs / 1000),
+         (unsigned long)(lockAvgNs / 1000));
+
+    VLOG(REPORT,
+         "[MS-GC] FreeManager.Reclaim: calls=%lu totalDur=%luus avgDur=%luus avgBatch=%.1f",
+         (unsigned long)s.reclaimCalls,
+         (unsigned long)(s.reclaimDurationNs / 1000),
+         (unsigned long)(reclaimAvgNs / 1000),
+         avgReclaimBatch);
+}
