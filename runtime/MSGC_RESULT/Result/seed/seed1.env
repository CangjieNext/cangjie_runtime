# seed1 — MSGC 调优参数集（来源：benchmark2 CopyGC vs MSGC 对比测试）
#
# 来源记录: MSGC/result/benchmark2_copygc_vs_msgc_seed4_20260405
# 创建时间: 2026-04-06
#
# 用法:
#   bash MSGC_RESULT/Result/script/run_case.sh \
#     --case case1_baseline --gc-mode compare --seed seed1 --tag seed1_compare

cjGCThreshold=16mb
cjGCInterval=100ms
CJ_MS_HEU_READY_WATERMARK=4
CJ_MS_EMPTY_CACHE_LOW_FLOOR_REGIONS=24
CJ_MS_EMPTY_CACHE_LOW_CAP_REGIONS=48
CJ_MS_EMPTY_SCAVENGE_MAX_REGIONS_PER_SLICE=16
CJ_MS_BG_SWEEP_PRESSURE_REGIONS_PER_SLICE=64
CJ_MS_INLINE_RECLAIM=1
