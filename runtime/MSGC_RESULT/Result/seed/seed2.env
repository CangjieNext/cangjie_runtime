# seed2 — 激进 RSS 压缩（aggressive）
#
# 策略：大幅缩小 empty cache 池 + 提高 GC 频率 + 加速 scavenge
# 目标：MSGC RSS 比 CopyGC 低 30%+
# 创建时间: 2026-04-06

cjGCThreshold=8mb
cjGCInterval=50ms
CJ_MS_HEU_READY_WATERMARK=2
CJ_MS_HEU_REQUEST_COOLDOWN=5ms
CJ_MS_EMPTY_CACHE_LOW_FLOOR_REGIONS=4
CJ_MS_EMPTY_CACHE_LOW_CAP_REGIONS=8
CJ_MS_EMPTY_CACHE_HIGH_FACTOR=1
CJ_MS_EMPTY_SCAVENGE_MAX_REGIONS_PER_SLICE=64
CJ_MS_BG_SWEEP_PRESSURE_REGIONS_PER_SLICE=128
CJ_MS_INLINE_RECLAIM=1
