# seed4 — 极端 RSS 压缩（extreme）
#
# 策略：cache 降到最低 + GC 极高频 + 所有 release budget 拉满
# 目标：探索 MSGC RSS 下限
# 创建时间: 2026-04-06

cjGCThreshold=2mb
cjGCInterval=10ms
CJ_MS_HEU_READY_WATERMARK=1
CJ_MS_HEU_REQUEST_COOLDOWN=1ms
CJ_MS_EMPTY_CACHE_LOW_FLOOR_REGIONS=1
CJ_MS_EMPTY_CACHE_LOW_CAP_REGIONS=2
CJ_MS_EMPTY_CACHE_HIGH_FACTOR=1
CJ_MS_EMPTY_SCAVENGE_MAX_REGIONS_PER_SLICE=256
CJ_MS_BG_SWEEP_PRESSURE_REGIONS_PER_SLICE=512
CJ_MS_BG_SWEEP_MAX_REGIONS_PER_SLICE=256
CJ_MS_MIN_HEADROOM_REGIONS=2
CJ_MS_INLINE_RECLAIM=1
