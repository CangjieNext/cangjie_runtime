+         "[MS-GC] NULLTI op=%s caller=%p ti=%p itf=%p x19=%p x20=%p x21=%p x22=%p x23=%p x24=%p",
+         op, caller, rawTi, rawItf, reinterpret_cast<void*>(regs.x19), reinterpret_cast<void*>(regs.x20),
+         reinterpret_cast<void*>(regs.x21), reinterpret_cast<void*>(regs.x22), reinterpret_cast<void*>(regs.x23),
+         reinterpret_cast<void*>(regs.x24));
+}
