+namespace {
+bool IsSlotTraceEnabled()
+{
+    static bool enabled = []() {
+        const char* env = std::getenv("CJ_MS_SLOT_TRACE");
+        return env != nullptr && env[0] != '\0' && std::strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
+
+bool SlotTracePermit()
+{
+    static size_t budget = []() -> size_t {
+        const char* env = std::getenv("CJ_MS_SLOT_TRACE_LIMIT");
+        if (env == nullptr || env[0] == '\0') {
+            return 256;
+        }
+        long value = std::strtol(env, nullptr, 10);
+        return value > 0 ? static_cast<size_t>(value) : 256;
+    }();
+    if (budget == 0) {
+        return false;
+    }
+    --budget;
+    return true;
+}
+
+bool IsNullTypeTraceEnabled()
+{
+    static bool enabled = []() {
+        const char* env = std::getenv("CJ_MS_NULL_TI_TRACE");
+        return env != nullptr && env[0] != '\0' && std::strcmp(env, "0") != 0;
+    }();
+    return enabled;
+}
+
+bool NullTypeTracePermit()
+{
+    static size_t budget = []() -> size_t {
+        const char* env = std::getenv("CJ_MS_NULL_TI_TRACE_LIMIT");
+        if (env == nullptr || env[0] == '\0') {
+            return 64;
+        }
+        long value = std::strtol(env, nullptr, 10);
+        return value > 0 ? static_cast<size_t>(value) : 64;
+    }();
+    if (budget == 0) {
+        return false;
+    }
+    --budget;
+    return true;
+}
+
+const char* GetSlotTraceTypeFilter()
+{
+    static const char* filter = []() -> const char* {
+        const char* env = std::getenv("CJ_MS_SLOT_TRACE_TYPE");
+        return (env != nullptr && env[0] != '\0') ? env : nullptr;
+    }();
+    return filter;
+}
+
+const char* GetSlotTraceTypeName(const BaseObject* obj)
+{
+    if (obj == nullptr) {
+        return "<null>";
+    }
+    TypeInfo* typeInfo = obj->GetTypeInfo();
+    if (typeInfo == nullptr || typeInfo->GetName() == nullptr) {
+        return "<unknown>";
+    }
+    return typeInfo->GetName();
+}
+
+bool MatchesSlotTraceType(const BaseObject* obj)
+{
+    const char* filter = GetSlotTraceTypeFilter();
+    if (filter == nullptr) {
+        return true;
+    }
+    return std::strstr(GetSlotTraceTypeName(obj), filter) != nullptr;
+}
+
+void MaybeLogNullStore(const char* op, const void* caller, BaseObject* dstObj, const void* slot,
+                       BaseObject* oldRef, BaseObject* newRef, const void* srcSlot)
+{
+    if (!IsSlotTraceEnabled() || oldRef == nullptr || newRef != nullptr) {
+        return;
+    }
+    if (!MatchesSlotTraceType(dstObj) && !MatchesSlotTraceType(oldRef)) {
+        return;
+    }
+    if (!SlotTracePermit()) {
+        return;
+    }
+    VLOG(REPORT,
+         "[MS-GC] SLOTTRACE bridge=%s caller=%p dstObj=%p dstType=%s slot=%p old=%p oldType=%s new=%p srcSlot=%p",
+         op, caller, static_cast<void*>(dstObj), GetSlotTraceTypeName(dstObj), slot, static_cast<void*>(oldRef),
+         GetSlotTraceTypeName(oldRef), static_cast<void*>(newRef), srcSlot);
+}
+
+void CaptureStructRefRange(BaseObject* obj, MAddress start, MAddress end,
+                           std::vector<const void*>& slots, std::vector<BaseObject*>& refs)
+{
+    if (obj == nullptr || !Heap::IsHeapAddress(obj)) {
+        return;
+    }
+    obj->ForEachRefInStruct(
+        [&slots, &refs](RefField<false>& refField) {
+            slots.push_back(&refField);
+            refs.push_back(refField.GetTargetObject());
+        },
+        start, end);
+}
+
+void LogCapturedStructNullStores(const char* op, const void* caller, BaseObject* dstObj,
+                                 const std::vector<const void*>& slots,
+                                 const std::vector<BaseObject*>& oldRefs,
+                                 MAddress start, MAddress end)
+{
+    if (slots.empty() || oldRefs.empty() || dstObj == nullptr || !Heap::IsHeapAddress(dstObj)) {
+        return;
+    }
+    size_t index = 0;
+    dstObj->ForEachRefInStruct(
+        [&](RefField<false>& refField) {
+            if (index >= slots.size() || index >= oldRefs.size()) {
+                return;
+            }
+            MaybeLogNullStore(op, caller, dstObj, slots[index], oldRefs[index], refField.GetTargetObject(), nullptr);
+            ++index;
+        },
+        start, end);
+}
+
+struct AArch64CallerRegs {
+    uintptr_t x19 = 0;
+    uintptr_t x20 = 0;
+    uintptr_t x21 = 0;
+    uintptr_t x22 = 0;
+    uintptr_t x23 = 0;
+    uintptr_t x24 = 0;
+};
+
+AArch64CallerRegs ReadAArch64CallerRegs()
+{
+    AArch64CallerRegs regs;
+#if defined(__aarch64__)
+    asm volatile(
+        "mov %0, x19\n\t"
+        "mov %1, x20\n\t"
+        "mov %2, x21\n\t"
+        "mov %3, x22\n\t"
+        "mov %4, x23\n\t"
+        "mov %5, x24\n\t"
+        : "=r"(regs.x19), "=r"(regs.x20), "=r"(regs.x21), "=r"(regs.x22), "=r"(regs.x23), "=r"(regs.x24));
+#endif
+    return regs;
+}
+
+void MaybeLogNullTypeInfo(const char* op, const void* caller, const void* rawTi, const void* rawItf)
+{
+    if (!IsNullTypeTraceEnabled() || rawTi != nullptr || !NullTypeTracePermit()) {
+        return;
