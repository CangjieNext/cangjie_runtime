+    if (phase != GCPhase::GC_PHASE_MS_CONCURRENT_MARK) {
+        return false;
+    }
+    return true;
+}
+
+static inline void EnqueueForRescan(BaseObject* obj, WriteBarrierBuffer& wbBuf)
+{
+    if (!ShouldProcessConcurrentMarkObject(obj)) {
+        return;
+    }
+    if (UNLIKELY(wbBuf.IsFull())) {
+        MarkSweepCollector* collector = MarkSweepCollector::GetActiveCollector();
+        if (collector != nullptr) {
+            collector->FlushWriteBarrierOverflow(wbBuf);
+        } else {
+            wbBuf.Clear();
+        }
+    }
+    wbBuf.Push(obj);
+    wbEnqueued.fetch_add(1, std::memory_order_relaxed);
+}
+
+static inline void EnqueueNewRefDuringConcurrentMark(BaseObject* obj, WriteBarrierBuffer& wbBuf)
+{
+    EnqueueForRescan(obj, wbBuf);
+}
