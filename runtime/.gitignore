CMakebuild/
output/
third_party/third_party_bounds_checking_function*.log
MSGC_RESULT/**/*.log

# Local development artifacts and auxiliary materials.
docs/superpowers/
test/
docs/assist/
build/

# Keep the Windows PE metadata regression source and runner under version
# control while continuing to ignore all ordinary build artifacts.
!build/
build/*
!build/tests/
!build/tests/windows/
!build/tests/windows/pe_metadata_range/
!build/tests/windows/pe_metadata_range/**
build/tests/windows/pe_metadata_range/output/

# Keep case source, scripts, payloads, and analysis under version control.
# Ignore only files created by local benchmark runs and language toolchains.
MSGC_RESULT/Result/**/result/
MSGC_RESULT/Result/**/classes/
MSGC_RESULT/Result/**/.gocache/
MSGC_RESULT/Result/**/.gotmp/
MSGC_RESULT/Result/**/*.class
MSGC_RESULT/Result/**/*.test
MSGC_RESULT/Result/**/*.exe
MSGC_RESULT/Result/**/*.cjo
MSGC_RESULT/Result/**/*.cjo.flag

# Keep bug reproducer sources, but not their generated outputs.
bugfix/**/out/
bugfix/**/temps/

# Local Runtime workspace artifacts and notes.
.DS_Store
.cache/
.github/
.superpowers/
.tmp/
.vscode/
MSGC/
MSGC_RESULT/doc/
MSGC_RESULT/temp/
__pycache__/
cases_without_level.txt
config.toml
default.cjo
default.cjo.flag
docs/
runtime.code-workspace
runtime-architecture*
third_party/third_party_bounds_checking_function/
tmp/
# Keep MSGC_RESULT bugfix notes, patches, and source snapshots under version
# control while ignoring generated diagnostics and local run artifacts.
MSGC_RESULT/bugfix/**/*.log*
MSGC_RESULT/bugfix/**/*.json
MSGC_RESULT/bugfix/**/*.xml
MSGC_RESULT/bugfix/**/*.out
MSGC_RESULT/bugfix/**/*.so*
MSGC_RESULT/bugfix/**/temp/
MSGC_RESULT/bugfix/**/log/
MSGC_RESULT/bugfix/**/out/
MSGC_RESULT/bugfix/**/temps/
MSGC_RESULT/bugfix/**/results.txt
MSGC_RESULT/bugfix/**/summary.txt
MSGC_RESULT/bugfix/**/status.txt
MSGC_RESULT/bugfix/**/framework_rc.txt

# Keep the complete MSGC bugfix investigation record, including repro
# artifacts and diagnostics, under version control.
!MSGC_RESULT/bugfix/
!MSGC_RESULT/bugfix/**/
!MSGC_RESULT/bugfix/**
