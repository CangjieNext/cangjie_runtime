    "src/runtime/timer/include/inner",
    "src/syscall/include",
    "src/syscall/include/inner",
    "src/syscall/include/${OS_FLAG}",
    "src/runtime/waitqueue/include",
    "src/runtime/waitqueue/include/inner",
    "src/sync/sema/include",
    "src/sync/sema/include/inner",
  ]
}

