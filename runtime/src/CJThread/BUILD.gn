config("cjthread_flags") {
  cflags_c -= ["-Wframe-larger-than=10240",]
  cflags_cc -= ["-Wframe-larger-than=10240",]
  asmflags -= ["-Wframe-larger-than=10240",]

  # cjthread compile options
  cjthread_options = [
    "-Wformat=2",
    "-Wpointer-arith",
    "-Wdate-time",
    "-Wswitch-default",
    "-Wshadow",
    "-Wvla",
    "-Wunused",
    "-Wundef",
    "-m64",
    "-fno-strict-aliasing",
    "-fsigned-char",
    "-fno-common",
  ]

  cflags_c += cjthread_options
  cflags_cc += cjthread_options
  asmflags += cjthread_options

  cflags_c += ["-fgnu89-inline",]

  # cjthread definitions
  defines = []
  defines += [
    "_LARGEFILE_SOURCE",
    "_FILE_OFFSET_BITS=64",
    "VOS_WORDSIZE=64",
    "VOS_BYTE_ORDER=VOS_LITTLE_ENDIAN",
    "USE___THREAD",
    "TLS_COMMON_DYNAMIC",
    "CANGJIE",
    "COMPILE_DYNAMIC",
  ]
  if (OHOS_FLAG == 2) {
    defines += [
      "OPENSSL_X86_64_PLATFORM",
    ]
  }

  if (TARGET_ARCH == "x86_64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 0 && OHOS_FLAG == 0) {
    # linux x86
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_X86",
      "MRT_HARDWARE_PLATFORM=MRT_X86",
      "VOS_CPU_TYPE=VOS_X86",
      "TRACE_FOLDER_PREFIX=\"linux_x86_64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_LINUX",
    ]
  } else if (TARGET_ARCH == "aarch64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 0 && OHOS_FLAG == 0){
    # linux aarch64
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_ARM",
      "MRT_HARDWARE_PLATFORM=MRT_ARM",
      "VOS_CPU_TYPE=VOS_CORTEXA72",
      "TRACE_FOLDER_PREFIX=\"linux_aarch64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_LINUX",
    ]
  } else if (TARGET_ARCH == "x86_64" && WINDOWS_FLAG == 1 && MACOS_FLAG == 0 && OHOS_FLAG == 0){
    # windows x86
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_X86",
      "MRT_HARDWARE_PLATFORM=MRT_WINDOWS_X86",
      "VOS_CPU_TYPE=VOS_X86",
      "TRACE_FOLDER_PREFIX=\"windows_x86_64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_WINDOWS",
    ]
  } else if (TARGET_ARCH == "x86_64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 1 && OHOS_FLAG == 0){
    # macos x86
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_X86",
      "MRT_HARDWARE_PLATFORM=MRT_X86",
      "VOS_CPU_TYPE=VOS_X86",
      "TRACE_FOLDER_PREFIX=\"macos_x86_64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_MACOS",
    ]
  } else if (TARGET_ARCH == "aarch64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 1 && OHOS_FLAG == 0){
    # macos aarch64
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_ARM",
      "MRT_HARDWARE_PLATFORM=MRT_ARM",
      "VOS_CPU_TYPE=VOS_CORTEXA72",
      "TRACE_FOLDER_PREFIX=\"macos_aarch64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_MACOS",
    ]
  } else if (TARGET_ARCH == "x86_64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 0 && OHOS_FLAG == 1){
    # ohos x86
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_X86",
      "MRT_HARDWARE_PLATFORM=MRT_X86",
      "VOS_CPU_TYPE=VOS_X86",
      "TRACE_FOLDER_PREFIX=\"linux_ohos_x86_64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_LINUX",
    ]
  } else if (TARGET_ARCH == "aarch64" && WINDOWS_FLAG == 0 && MACOS_FLAG == 0 && OHOS_FLAG == 1){
    # ohos aarch64
    defines += [
      "VOS_HARDWARE_PLATFORM=VOS_ARM",
      "MRT_HARDWARE_PLATFORM=MRT_ARM",
      "VOS_CPU_TYPE=VOS_ARM",
      "TRACE_FOLDER_PREFIX=\"linux_ohos_aarch64\"",
      "VOS_OS_VER=VOS_LINUX",
      "MRT_LINUX",
    ]
  }

  if (GN_BUILD_TYPE == "Debug") {
    defines += [
      "VOS_BUILD_DEBUG=1",
    ]
  } else {
    defines += [
      "VOS_BUILD_RELEASE=1",
    ]
  }

  if (OHOS_FLAG != 0) {
    defines += [
      "OHOS"
    ]
    include_dirs += [
      "${CHART_ROOT}/third_party/openssl/include",
    ]
  }
  if (OHOS_FLAG != 0) {
    include_dirs += [
      "${CHART_ROOT}/out/${OHOS_INCLUDE_PATH}/obj/third_party/openssl/build_all_generated/linux-${TARGET_ARCH}/include",
      " -idirafter${CHART_ROOT}/out/${OHOS_INCLUDE_PATH}/obj/third_party/musl/usr/include/${TARGET_ARCH}-linux-ohos",
    ]
  }

  defines += ptrauth_cfi_defines

  if (GN_BUILD_TYPE == "Debug") {
    cflags_c += ["-Wframe-larger-than=2048",]
    cflags_cc += ["-Wframe-larger-than=2048",]
    defines += [
      "CJTHREAD_DEBUG=1",
    ]
  }
}

if (TARGET_ARCH == "aarch64") {
  CPU_FAMILY="arm"
  CPU_CORE="arm64"
} else {
  CPU_FAMILY="x86"
  CPU_CORE="x86_64"
}

action("cjthread_include_install") {
  script = "${CHART_ROOT}/build/scripts/cjthread_cp_include.py"
  args = [
    "${CHART_ROOT}/src/CJThread/include_list.txt",
    "$target_out_dir/include",
    CPU_FAMILY,
    CPU_CORE,
  ]
  outputs = [ "$target_gen_dir/", ]
}

