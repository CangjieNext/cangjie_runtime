      "SignalManager.cpp",
    ]
  }
  if ( OHOS_FLAG == 0 && WINDOWS_FLAG == 0 && MACOS_FLAG == 0) {
    sources += [
      "arch_os/${TARGET_ARCH}_${OS_FLAG}/CjNativeRuntimeStartAndEnd.S",
    ]
  }

  include_dirs += [
    "Demangler",
    "Heap",
    "Loader",
    "Loader/BinaryFile",
    "Loader/BinaryFile/CjFile",
    "Loader/CjFileLoader",
    "CJThread/src/base/external/include",
  ]
  include_dirs += include_Sanitzer
}

