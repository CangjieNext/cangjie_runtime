static_library("demangler") {
  sources = [
    "Demangler.cpp",
    "DeCompression.cpp",
    "../Base/CString.cpp",
    "../Base/FixedCString.cpp",
  ]
}

static_library("libcangjie-demangle") {
  cflags_c += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  cflags_cc += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  sources = [
    "Demangler.cpp",
    "DeCompression.cpp",
    "CangjieDemangle.cpp",
  ]
}

executable("cjfilt") {
  cflags_c += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  cflags_cc += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  sources = [
    "DeCompression.cpp",
    "Demangler.cpp",
    "Cjfilt.cpp",
  ]
  deps = [
    ":demangler"
  ]

  ldflags += [
    "-fPIE",
    "-pie",
  ]
}