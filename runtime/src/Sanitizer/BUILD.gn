include_Sanitzer = [
  "Sanitizer",
]
if (ASAN_SUPPORT_FLAG == 1) {
  source_Sanitizer = [
    "AddressSanitizer/AsanInterface.cpp",
  ]
  include_Sanitzer += [
    "AddressSanitizer",
  ]
} else if (TSAN_SUPPORT_FLAG == 1) {
  source_Sanitizer = [
    "ThreadSanitizer/TsanInterface.cpp",
  ]
  include_Sanitzer += [
    "ThreadSanitizer",
  ]
} else if (HWASAN_SUPPORT_FLAG == 1) {
  source_Sanitizer = [
    "HwAddressSanitizer/HwasanInterface.cpp",
  ]
  include_Sanitzer += [
    "HwAddressSanitizer",
  ]
} else if (GWPASAN_SUPPORT_FLAG == 1) {
  source_Sanitizer = [
    "GwpAddressSanitizer/GwpAsanInterface.cpp",
  ]
  include_Sanitzer += [
    "GwpAddressSanitizer",
  ]
} else {
  source_Sanitizer = []
}

static_library("libSanitizer") {
  cflags_c += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  cflags_cc += ["-DBUILD_LIB_CANGJIE_DEMANGLE"]
  sources = source_Sanitizer
  include_dirs += include_Sanitzer
}

