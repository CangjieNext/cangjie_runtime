Date: Fri, 7 Aug 2026 16:14:49 +0800
Subject: [PATCH] =?UTF-8?q?=E5=87=8F=E5=B0=91=E5=AD=97=E7=AC=A6=E4=B8=B2?=
 =?UTF-8?q?=E3=80=81=E5=AF=B9=E8=B1=A1=E5=92=8C=20HTTP=20body=20=E7=9A=84?=
 =?UTF-8?q?=E5=A4=8D=E5=88=B6?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 src/stdx/encoding/json/json_object.cj  | 31 ++++++++++++++++++++++++--
 src/stdx/encoding/json/json_value.cj   | 15 +++++++++++++
 src/stdx/encoding/json/native.cj       |  2 +-
 src/stdx/encoding/json/write_buffer.cj | 11 +++++++--
 4 files changed, 54 insertions(+), 5 deletions(-)

diff --git a/src/stdx/encoding/json/json_object.cj b/src/stdx/encoding/json/json_object.cj
index 723522e..f75abe2 100644
--- a/src/stdx/encoding/json/json_object.cj
+++ b/src/stdx/encoding/json/json_object.cj
@@ -242,6 +242,9 @@ public class JsonInt <: JsonValue {
 public class JsonFloat <: JsonValue {
     /* Json data of the JsonFloat(Float64). */
     private var value: Float64
+    private var rawData: ?Array<Byte> = None
+    private var rawStart: Int64 = 0
+    private var rawSize: Int64 = 0
 
     /**
      * Create a new JsonFloat object.
@@ -267,6 +270,13 @@ public class JsonFloat <: JsonValue {
         this.value = Float64(v)
     }
 
+    init(fv: Float64, rawData: Array<Byte>, rawStart: Int64, rawSize: Int64) {
+        this.value = fv
+        this.rawData = rawData
+        this.rawStart = rawStart
+        this.rawSize = rawSize
+    }
+
     /**
      * Get the value data of the JsonFloat.
      *
@@ -297,7 +307,9 @@ public class JsonFloat <: JsonValue {
      * @since 0.17.4
      */
     public func toString(): String {
-        return value.toString()
+        let buff = WriteBuffer(writeCapacity())
+        appendTo(buff)
+        return unsafe { String.fromUtf8Unchecked(buff.getAndClear()) }
     }
 
     /**
@@ -317,7 +329,7 @@ public class JsonFloat <: JsonValue {
      * @return json-converted String is value string data.
      */
     public func toStringWithoutEscaping(): String {
-        return value.toString()
+        return toString()
     }
 
     /**
@@ -328,6 +340,21 @@ public class JsonFloat <: JsonValue {
     public func toJsonStringWithoutEscaping(): String {
         return toString()
     }
+
+    func appendTo(buff: WriteBuffer): Unit {
+        if (let Some(data) <- rawData) {
+            buff.append(data, rawStart, rawSize)
+        } else {
+            buff.append(value)
+        }
+    }
+
+    func writeCapacity(): Int64 {
+        if (let Some(_) <- rawData) {
+            return rawSize
+        }
+        return MAX_FLOAT64_JSON_SIZE
+    }
 }
 
 /**
diff --git a/src/stdx/encoding/json/json_value.cj b/src/stdx/encoding/json/json_value.cj
index 7e183fd..dafe6fd 100644
--- a/src/stdx/encoding/json/json_value.cj
+++ b/src/stdx/encoding/json/json_value.cj
@@ -81,6 +81,21 @@ sealed abstract class JsonValue <: ToString {
         parseString(s)
     }
 
+    /**
+     * Convert JsonValue to a JSON string using the caller-provided output capacity.
+     *
+     * @param capacity Initial output-buffer capacity in bytes.
+     * @return json-converted String.
+     */
+    public func toStringWithCapacity(capacity: Int64): String {
+        if (capacity < 0) {
+            throw IllegalArgumentException("Capacity cannot be negative.")
+        }
+        let buff = WriteBuffer(capacity)
+        jsonWriteWithoutFormat(this, buff)
+        return unsafe { String.fromUtf8Unchecked(buff.getAndClear()) }
+    }
+
     /**
      * Determine the JSON type to which the JsonValue belongs.
      *
diff --git a/src/stdx/encoding/json/native.cj b/src/stdx/encoding/json/native.cj
index e422ddc..180a172 100644
--- a/src/stdx/encoding/json/native.cj
+++ b/src/stdx/encoding/json/native.cj
@@ -436,7 +436,7 @@ func parseJsonNumberSlow(parser: JsonParser): JsonValue {
             let ptr = acquireArrayRawData(parser.data)
             let value = CJ_JSON_ParseFloat64(ptr.pointer, leftIndex, rightIndex)
             releaseArrayRawData(ptr)
-            return JsonFloat(ensureFiniteJsonFloat(value))
+            return JsonFloat(ensureFiniteJsonFloat(value), parser.data, leftIndex, rightIndex - leftIndex)
         }
     }
     let numStr = unsafe { String.fromUtf8Unchecked(parser.data[leftIndex..rightIndex]) }
diff --git a/src/stdx/encoding/json/write_buffer.cj b/src/stdx/encoding/json/write_buffer.cj
index 221d7d1..142ba78 100644
--- a/src/stdx/encoding/json/write_buffer.cj
+++ b/src/stdx/encoding/json/write_buffer.cj
@@ -87,6 +87,13 @@ class WriteBuffer {
         return this
     }
 
+    func append(arr: Array<Byte>, offset: Int64, length: Int64): WriteBuffer {
+        checkAndExpend(length)
+        arr.copyTo(_buffer, offset, _size, length)
+        _size += length
+        return this
+    }
+
     func append(str: String): WriteBuffer {
         append(unsafe { str.rawData() })
         return this
@@ -219,7 +226,7 @@ func jsonWriteWithoutFormat(json: JsonValue, buff: WriteBuffer, depth: Int64, ht
         case js: JsonString => buff.append(b'\"').appendEscape(js.getValue(), htmlSafe:htmlSafe).append(b'\"')
         case jb: JsonBool => buff.append(jb.getValue())
         case ji: JsonInt => buff.append(ji.getValue())
-        case jf: JsonFloat => buff.append(jf.getValue())
+        case jf: JsonFloat => jf.appendTo(buff)
         case _ => buff.append(NULL_STRING)
     }
 }
@@ -318,7 +325,7 @@ func asumecapacity(json: JsonValue, depth: Int64): Int64 {
         case js: JsonString => return js.value.size + 2 // "value"
         case _: JsonBool => return 5 // max of "false" and "true" 
         case _: JsonInt => return 22 // max len is 22
-        case _: JsonFloat => return 200 // not precision 
+        case jf: JsonFloat => return jf.writeCapacity()
         case _ => return 4 // len of "null" is 4
     }
 }
