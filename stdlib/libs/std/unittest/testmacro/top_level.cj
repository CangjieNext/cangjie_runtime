macro package std.unittest.testmacro

import std.ast.*

// Name of the macro of concurrent testing. It is declared by another macro package, which cannot
// access the storage of this one, so annotations nested in it are forwarded to it through the
// compiler's macro message channel.
private const CONCURRENT_TEST_MACRO_NAME = "ConcurrentTest"
private const CONCURRENT_TEST_ATTR_PREFIX = CONCURRENT_TEST_MACRO_NAME + "_"

func topLevelMacroDriver(key: MacroKey, input: Tokens,
        args: Tokens, parentCheck: (key: MacroKey) -> Bool): Tokens {
    let tokens = key.write(input, args: args)
    for (pkey in MacroKey.allSupportedMacros()) {
        if (parentCheck(pkey)) {
            return tokens
        }
    }
    if (insideParentContext(CONCURRENT_TEST_MACRO_NAME)) {
        // The annotation is applied inside a macro call of another macro package, which does not see
        // the annotations of this one. Forward it through the compiler's macro message channel,
        // keyed by this macro and the annotated declaration.
        if (let Some(name) <- declaredName(input)) {
            setItem(key.macroIdentifier + "@" + name, args)
        }
        return tokens
    }

    let decl = parseDecl(tokens)
    verifyNotOnGeneratedConcurrentTest(key, decl)
    key.verifyDecl(decl)

    if (let Some(_) <- decl.loadSingle(TEST_MACRO)) {
        return InstrumentedClass.fromDecl(TEST_MACRO, decl, input).toTokens()
    }
    if (let Some(_) <- decl.loadSingle(TEST_BUILDER_MACRO)) {
        return emitTestBuilder(decl, input)
    }
    if (let Some(_) <- decl.loadSingle(TEST_TEMPLATE_MACRO)) {
        return InstrumentedClass.fromDecl(TEST_TEMPLATE_MACRO, decl, input).toTokens()
    }
    if (let Some(_) <- decl.loadSingle(ASSERTION_MACRO)) {
        return emitCustomAssertionBuilder(decl)
    }

    let additionalErrors = MacroErrors()
    additionalErrors.add(
        "${key} macro on top level must be used together with ${TEST_MACRO}, ${TEST_TEMPLATE_MACRO} or ${TEST_BUILDER_MACRO}.")
    additionalErrors.report()

    return tokens
}

private func declaredName(input: Tokens): ?String {
    try {
        Some(unwrapDecl(parseDecl(input)).identifier.value)
    } catch (e: Exception) {
        None
    }
}

private func unwrapDecl(decl: Decl): Decl {
    match (decl) {
        case makro: MacroExpandDecl => try { unwrapDecl(makro.macroInputDecl) } catch (_) { decl }
        case _ => decl
    }
}

/**
 * The annotations of one declaration are expanded innermost first: by the time the annotation written
 * before @ConcurrentTest is expanded, the test class has already been generated by that macro of
 * another macro package, so the value of this annotation can not be applied to it. Annotations
 * nested in the @ConcurrentTest call are forwarded to it instead (see the hook in the driver above),
 * so this case has to be reported rather than silently ignored.
 */
private func verifyNotOnGeneratedConcurrentTest(key: MacroKey, decl: Decl): Unit {
    if (!MacroStorage.hasAttrsWithPrefix(decl, CONCURRENT_TEST_ATTR_PREFIX)) {
        return
    }
    match (key.kind) {
        case TestEntity =>
            MacroErrors.doThrow("@${CONCURRENT_TEST_MACRO_NAME} macro can't be used together with ${key}.")
        case _ =>
            MacroErrors.doThrow("${key} macro must be written after @${CONCURRENT_TEST_MACRO_NAME} macro on the "
                + "same declaration, otherwise it is not applied to the generated test class.")
    }
}
