package std.core

/**
 * Alias for UInt8, representing a byte value.
 *
 * @type UInt8
 */
public type Byte = UInt8

/**
 * Alias for Int64, representing a platform-native integer value.
 *
 * @type Int64
 */
public type Int = Int64

/**
 * Alias for UInt64, representing a platform-native unsigned integer value.
 *
 * @type UInt64
 */
public type UInt = UInt64
